# ============================================================
# J.A.R.V.I.S. CONFIGURATION ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env and configure your variables.
# NEVER commit the actual .env file with real secrets!

# Gemini AI API Key (Get from https://aistudio.google.com/)
# If empty, JARVIS will operate seamlessly in "JARVIS DEMO MODE"
GEMINI_API_KEY=

# Application Secret Key for JWT encryption and session signing
# Generate a secure 64-char key in production: openssl rand -hex 32
SECRET_KEY=jarvis-quantum-core-super-secret-key-change-in-production-2026

# Database Connection URL
# Development SQLite: sqlite:///./jarvis.db
# Production PostgreSQL: postgresql+psycopg2://jarvis:password@localhost:5432/jarvis_db
DATABASE_URL=sqlite:///./jarvis.db

# Optional Google OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Model Preferences
GEMINI_MODEL=gemini-2.5-flash
MAX_TOKENS=2048
AI_TEMPERATURE=0.7
